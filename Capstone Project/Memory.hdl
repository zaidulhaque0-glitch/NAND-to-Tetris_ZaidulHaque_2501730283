// Unified Hack address space: RAM16K, screen-mapped memory, and keyboard.
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // The first two 8K regions together form the full 16K RAM.
    DMux4Way(in=load, sel=address[13..14], a=loadRamLow, b=loadRamHigh,
             c=loadScreen, d=loadKeyboard);
    Or(a=loadRamLow, b=loadRamHigh, out=loadRam);
    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=keyboardOut,
              sel=address[13..14], out=out);
}
